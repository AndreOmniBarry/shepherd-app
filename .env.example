# ============================================================
# SHEP.HERD — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ── Anthropic ────────────────────────────────────────────────
# From: console.anthropic.com → API Keys

ANTHROPIC_API_KEY=REDACTED

# ── Web Push (real OS-level notifications, even when the tab/app is
#    closed — on top of the in-tab chime/badge, which needs none of this) ──
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is also read client-side (NEXT_PUBLIC_), so it must be
# set at BUILD time, not just runtime, for the client bundle to have it.
# Leaving these unset just disables push silently — the in-tab chime,
# badge, and same-tab-backgrounded alert all keep working regardless.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@justshephrd.com

# ── JWT ──────────────────────────────────────────────────────
# Generate a random 32+ character string.
# Example: openssl rand -base64 32
# Change this before going to production.

JWT_SECRET=shepherd-dev-secret-CHANGE-this-before-production-32chars

# ── Performance (Mojave MacBook Air) ─────────────────────────
# Prevents Next.js dev server from eating all RAM on 4GB machines.

NODE_OPTIONS=--max-old-space-size=2048

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SHEP.HERD
NEXT_PUBLIC_CHURCH_NAME=The Comforters House Global

# ── Internal notification dispatch ───────────────────────────
# Used server-to-server between routes and /api/notify/dispatch. Generate a
# random string — without this set, internal notification dispatch is refused.
INTERNAL_SECRET=

# ── Absence-check cron ───────────────────────────────────────
# Required to call /api/care/trigger-alerts and trigger-midweek-alerts from
# an external scheduler (cron-job.org, Vercel Cron, etc). Generate a random
# string — without this set, those endpoints refuse every request.
CRON_SECRET=

# ── SMS (optional — leave blank until you have a provider) ───
# Once set, new-member welcome texts start sending automatically — no code
# changes needed. See src/lib/sms.ts.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SHEPHERD

# ── Paystack (optional — leave blank until you have a Paystack account) ──
# Once set, self-service plan upgrades in /api/subscription and the
# recurring-billing webhook at /api/webhooks/paystack activate — no code
# changes needed. From: Paystack Dashboard → Settings → API Keys & Webhooks.
# Set the same value as the webhook's signing secret in that same dashboard
# page — Paystack signs every webhook call with it.
PAYSTACK_SECRET_KEY=
